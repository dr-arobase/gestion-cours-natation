{
  "name": "swimming-lifeguard-management",
  "version": "1.0.0",
  "description": "Application complète de gestion de cours de natation et sauvetage",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix frontend",
    "start": "npm start --prefix backend",
    "create-admin": "npm run create-admin --prefix backend"
  },
  "keywords": ["swimming", "lifeguard", "management", "courses"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
